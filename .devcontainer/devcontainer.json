{
  // GitHub Codespaces / Dev Containers: the whole platform in the cloud, in one click.
  // On open: PostgreSQL + Mailpit (Docker), configuration, migrations, demo data,
  // production build and server on the codespace's https address (npm run codespace).
  "name": "Abdou Academy",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "forwardPorts": [3000, 8025],
  "portsAttributes": {
    "3000": { "label": "Abdou Academy", "onAutoForward": "openBrowser" },
    "8025": { "label": "Sign-in codes (Mailpit)", "onAutoForward": "silent" },
    "1025": { "onAutoForward": "ignore" },
    "5432": { "onAutoForward": "ignore" }
  },
  "postCreateCommand": "npm ci",
  "postAttachCommand": "npm run codespace",
  "customizations": {
    "codespaces": { "openFiles": ["docs/TRY_IT.ar.md"] },
    "vscode": { "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"] }
  }
}

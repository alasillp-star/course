# ----------------------------------------------------------------------------
# Academy platform — environment template. Copy to .env.local (development) or
# configure in your host's secret store (production). Never commit real values.
# Generate secrets with:  npm run secrets:generate
# ----------------------------------------------------------------------------

# development | test | staging | production  (staging/production enforce HTTPS,
# a real e-mail transport, MFA for staff and distinct secrets)
APP_ENV=development
# Public origin. Printed inside every QR code: choose the final domain before printing cards.
# Also the base of the integration and webhook URLs given to the landing page and the carrier.
APP_URL=http://localhost:3000

# PostgreSQL 16+. Add ?sslmode=require for managed databases.
DATABASE_URL=postgres://academy:academy_dev_password@127.0.0.1:5432/academy_dev
DATABASE_POOL_MAX=10
# Set to false behind transaction poolers (Supabase :6543, Neon pooled, PgBouncer).
DATABASE_PREPARE=true

# Secrets: base64 of 32 random bytes each, all different.
AUTH_SECRET=
ACTIVATION_CODE_PEPPER=
DATA_ENCRYPTION_KEY=
# During key rotation only: the previous DATA_ENCRYPTION_KEY.
# DATA_ENCRYPTION_KEY_PREVIOUS=

# E-mail: smtp | resend | dev-outbox (dev-outbox writes JSON files; refused in staging/production)
EMAIL_TRANSPORT=dev-outbox
EMAIL_FROM="Abdou Academy <no-reply@example.com>"
# EMAIL_REPLY_TO=support@example.com
# SMTP_URL=smtps://user:password@smtp.example.com:465
# RESEND_API_KEY=
DEV_MAIL_OUTBOX_DIR=.data/mailbox

# Security
# Trust X-Real-IP / X-Forwarded-For (true on Vercel or behind your own reverse proxy).
TRUST_PROXY_HEADERS=true
STAFF_MFA_REQUIRED=true
STAFF_MFA_MAX_AGE_HOURS=12
SESSION_MAX_AGE_DAYS=30
# Max simultaneous signed-in devices per account (0 = unlimited).
MAX_ACTIVE_SESSIONS_PER_USER=5

# First Super Admin, created by `npm run db:seed` when none exists.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# ----------------------------------------------------------------------------
# Video hosting: none | mux | cloudflare_stream   (local = development/tests only)
# ----------------------------------------------------------------------------
VIDEO_PROVIDER=none
# Mux: access token (Settings → Access tokens, Video read+write), a URL signing key and a webhook
# pointing to https://<domain>/api/v1/webhooks/video/mux
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_KEY_PRIVATE=          # base64 of the PEM private key, as Mux gives it
# MUX_WEBHOOK_SECRET=
# MUX_PLAYBACK_RESTRICTION_ID=      # optional: referrer restriction (your domain only)
# MUX_VIDEO_QUALITY=basic
# Cloudflare Stream: API token (Stream:Edit), signing key (POST /stream/keys) and a webhook to
# https://<domain>/api/v1/webhooks/video/cloudflare-stream
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# CLOUDFLARE_STREAM_CUSTOMER_CODE=  # the xxxx in customer-xxxx.cloudflarestream.com
# CLOUDFLARE_STREAM_SIGNING_KEY_ID=
# CLOUDFLARE_STREAM_SIGNING_KEY_PEM= # base64 PEM ("pem" field returned by the API)
# CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Lesson files: none | s3   (local = development/tests only)
# Any S3-compatible service: AWS S3, Cloudflare R2, Supabase Storage (S3 API), Backblaze B2, MinIO.
# The bucket must stay PRIVATE; downloads use 5-minute presigned URLs. Configure CORS for PUT from APP_URL.
# ----------------------------------------------------------------------------
STORAGE_PROVIDER=none
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# MAX_UPLOAD_FILE_MB=50
# MAX_UPLOAD_VIDEO_MB=8192
LOCAL_STORAGE_DIR=.data/storage

# ----------------------------------------------------------------------------
# Integrations (docs/INTEGRATIONS.md). Each token: 32+ random characters (openssl rand -hex 32),
# given to ONE sender and kept on its server side (never in a website's front-end code).
# Unset = endpoint disabled.
# ----------------------------------------------------------------------------
# Landing page → POST /api/v1/integrations/orders
# ORDERS_INTEGRATION_TOKEN=
# Delivery company → POST /api/v1/integrations/delivery
# DELIVERY_WEBHOOK_TOKEN=
# Optional HMAC-SHA256 signature of the body (X-Signature: sha256=<hex>) if the carrier supports it
# DELIVERY_WEBHOOK_SECRET=

# Public (exposed to the browser)
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

LOG_LEVEL=info
